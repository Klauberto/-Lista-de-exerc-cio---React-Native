    marginBottom: 4,
  },
  valorSaldo: {
    color: '#FFFFFF',
    fontSize: 28,
    fontWeight: 'bold',
  },
  input: {
    backgroundColor: '#1E1E1E',
    color: '#FFFFFF',
    borderRadius: 10,
