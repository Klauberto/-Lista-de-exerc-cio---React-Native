import React, { useState } from 'react';
import {
  StyleSheet,
  Text,
  View,
  TextInput,
  TouchableOpacity,
  Keyboard,
} from 'react-native';

export default function App() {
  const [saldo, setSaldo] = useState(1000);
  const [valor, setValor] = useState('');
  const [erro, setErro] = useState('');
  const [mensagem, setMensagem] = useState('');

  function formatarMoeda(num) {
    return (
      'R$ ' +
      num
        .toFixed(2)
        .replace('.', ',')
        .replace(/\B(?=(\d{3})+(?!\d))/g, '.')
    );
  }

  function realizarOperacao(tipo) {
    Keyboard.dismiss();

    let textoLimpo = valor.trim();
    if (textoLimpo.includes(',')) {
      textoLimpo = textoLimpo.replace(/\./g, '').replace(',', '.');
    }

    if (textoLimpo === '') {
      setErro('Informe um valor para a operação.');
      setMensagem('');
      return;
    }

    const quantia = Number(textoLimpo);

    if (isNaN(quantia) || quantia <= 0) {
      setErro('Digite um valor numérico maior que zero.');
      setMensagem('');
      return;
    }

    if (tipo === 'sacar' && quantia > saldo) {
      setErro('Saldo insuficiente para este saque.');
      setMensagem('');
      return;
    }

    const novoSaldo =
      tipo === 'depositar'
        ? Math.round((saldo + quantia) * 100) / 100
        : Math.round((saldo - quantia) * 100) / 100;

    setSaldo(novoSaldo);
    setValor('');
    setErro('');
    setMensagem(
      `${tipo === 'depositar' ? 'Depósito' : 'Saque'} de ${formatarMoeda(quantia)} realizado.`
    );
  }

  return (
    <View style={styles.container}>
      <Text style={styles.titulo}>Simulador Bancário</Text>

      <View style={styles.cardSaldo}>
        <Text style={styles.labelSaldo}>Saldo disponível</Text>
        <Text style={styles.valorSaldo}>{formatarMoeda(saldo)}</Text>
      </View>

      <TextInput
        style={styles.input}
        placeholder="Valor em R$ (ex: 200,00)"
        placeholderTextColor="#888"
        keyboardType="numeric"
        value={valor}
        onChangeText={setValor}
      />

      <View style={styles.botoesContainer}>
        <TouchableOpacity
          style={[styles.botao, styles.botaoDepositar]}
          onPress={() => realizarOperacao('depositar')}
        >
          <Text style={styles.textoBotao}>Depositar</Text>
        </TouchableOpacity>

        <TouchableOpacity
          style={[styles.botao, styles.botaoSacar]}
          onPress={() => realizarOperacao('sacar')}
        >
          <Text style={styles.textoBotao}>Sacar</Text>
        </TouchableOpacity>
      </View>

      {erro !== '' && <Text style={styles.erro}>{erro}</Text>}
      {mensagem !== '' && <Text style={styles.sucesso}>{mensagem}</Text>}
    </View>
  );
}

