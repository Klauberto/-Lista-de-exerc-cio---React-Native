import React, { useState } from 'react';
import {
  StyleSheet,
  Text,
  View,
  TextInput,
  TouchableOpacity,
  Keyboard,
} from 'react-native';

export default function App() {
  const [temperatura, setTemperatura] = useState('');
  const [sentido, setSentido] = useState('CtoF'); // 'CtoF' ou 'FtoC'
  const [resultado, setResultado] = useState(null);
  const [erro, setErro] = useState('');

  function formatarNumero(num) {
    return Number(num.toFixed(2)).toString().replace('.', ',');
  }

  function alterarSentido(novoSentido) {
    setSentido(novoSentido);
    setResultado(null);
    setErro('');
  }

  function converter() {
    Keyboard.dismiss();
    const textoLimpo = temperatura.trim().replace(',', '.');

    if (textoLimpo === '') {
      setErro('Informe uma temperatura.');
      setResultado(null);
      return;
    }

    const valor = Number(textoLimpo);

    if (isNaN(valor)) {
      setErro('Digite um valor numérico válido.');
      setResultado(null);
      return;
    }

    const convertido =
      sentido === 'CtoF' ? (valor * 9) / 5 + 32 : ((valor - 32) * 5) / 9;

    const origem = sentido === 'CtoF' ? '°C' : '°F';
    const destino = sentido === 'CtoF' ? '°F' : '°C';

    setErro('');
    setResultado(
      `${formatarNumero(valor)} ${origem} = ${formatarNumero(convertido)} ${destino}`
    );
  }

  return (
    <View style={styles.container}>
      <Text style={styles.titulo}>Conversor de Temperatura</Text>

      <View style={styles.seletorContainer}>
        <TouchableOpacity
          style={[
            styles.opcao,
            sentido === 'CtoF' && styles.opcaoAtiva,
          ]}
          onPress={() => alterarSentido('CtoF')}
        >
          <Text style={styles.textoOpcao}>°C → °F</Text>
        </TouchableOpacity>

        <TouchableOpacity
          style={[
            styles.opcao,
            sentido === 'FtoC' && styles.opcaoAtiva,
          ]}
          onPress={() => alterarSentido('FtoC')}
        >
          <Text style={styles.textoOpcao}>°F → °C</Text>
        </TouchableOpacity>
      </View>

      <TextInput
        style={styles.input}
        placeholder={
          sentido === 'CtoF'
            ? 'Temperatura em °C (ex: 30)'
            : 'Temperatura em °F (ex: 86)'
        }
        placeholderTextColor="#888"
        keyboardType="numbers-and-punctuation"
        value={temperatura}
        onChangeText={setTemperatura}
      />

      <TouchableOpacity style={styles.botao} onPress={converter}>
        <Text style={styles.textoBotao}>Converter</Text>
      </TouchableOpacity>

      {erro !== '' && <Text style={styles.erro}>{erro}</Text>}

      {resultado !== null && (
        <View style={styles.card}>
          <Text style={styles.label}>Resultado:</Text>
          <Text style={styles.valor}>{resultado}</Text>
        </View>
      )}
    </View>
  );
}

