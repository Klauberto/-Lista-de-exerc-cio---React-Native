import React, { useState } from 'react';
import {
  StyleSheet,
  Text,
  View,
  TextInput,
  TouchableOpacity,
  Keyboard,
} from 'react-native';

export default function App() {
  const [peso, setPeso] = useState('');
  const [resultado, setResultado] = useState(null);
  const [erro, setErro] = useState('');

  function calcularConsumo() {
    Keyboard.dismiss();
    const textoLimpo = peso.trim().replace(',', '.');

    if (textoLimpo === '') {
      setErro('Informe o seu peso.');
      setResultado(null);
      return;
    }

    const pesoNum = Number(textoLimpo);

    if (isNaN(pesoNum) || pesoNum <= 0) {
      setErro('Digite um valor numérico maior que zero.');
      setResultado(null);
      return;
    }

    const litros = (pesoNum * 35) / 1000;
    setErro('');
    setResultado(litros.toFixed(2).replace('.', ','));
  }

  return (
    <View style={styles.container}>
      <Text style={styles.titulo}>Hidratação Diária</Text>

      <TextInput
        style={styles.input}
        placeholder="Peso em kg (ex: 70)"
        placeholderTextColor="#888"
        keyboardType="numeric"
        value={peso}
        onChangeText={setPeso}
      />

      <TouchableOpacity style={styles.botao} onPress={calcularConsumo}>
        <Text style={styles.textoBotao}>Calcular</Text>
      </TouchableOpacity>

      {erro !== '' && <Text style={styles.erro}>{erro}</Text>}

      {resultado !== null && (
        <View style={styles.card}>
          <Text style={styles.label}>Consumo estimado:</Text>
          <Text style={styles.valor}>{resultado} litros por dia</Text>
        </View>
      )}
    </View>
  );
}

