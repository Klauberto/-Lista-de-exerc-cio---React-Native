    borderColor: '#333',
  },
  botao: {
    backgroundColor: '#FF6B00',
    padding: 15,
    borderRadius: 10,
    alignItems: 'center',
  },
  textoBotao: {
    color: '#FFFFFF',
    fontSize: 16,
    fontWeight: 'bold',
  },
  erro: {
    color: '#FF5252',
    textAlign: 'center',
