import React, { useState } from 'react';
import {
  StyleSheet,
  Text,
  View,
  TouchableOpacity,
  ScrollView,
} from 'react-native';

const CARDAPIO = [
  { id: 1, nome: 'Sanduíche', preco: 8.0 },
  { id: 2, nome: 'Suco', preco: 5.0 },
  { id: 3, nome: 'Salgado Assado', preco: 6.0 },
  { id: 4, nome: 'Bolo Caseiro', preco: 4.5 },
];

export default function App() {
  const [quantidades, setQuantidades] = useState({
    1: 1,
    2: 1,
    3: 1,
    4: 1,
  });
  const [pedido, setPedido] = useState([]);
  const [resumoVisivel, setResumoVisivel] = useState(false);

  function formatarMoeda(valor) {
    return (
      'R$ ' +
      valor
        .toFixed(2)
        .replace('.', ',')
        .replace(/\B(?=(\d{3})+(?!\d))/g, '.')
    );
  }

  function alterarQuantidade(id, delta) {
    setQuantidades((atual) => ({
      ...atual,
      [id]: Math.max(1, (atual[id] || 1) + delta),
    }));
  }

  function adicionarItem(produto) {
    const qtdSelecionada = quantidades[produto.id] || 1;
    setResumoVisivel(false);

    setPedido((atual) => {
      const existente = atual.find((item) => item.id === produto.id);

      if (existente) {
        return atual.map((item) => {
          if (item.id !== produto.id) return item;
          const novaQtd = item.quantidade + qtdSelecionada;
          return {
            ...item,
            quantidade: novaQtd,
            subtotal: Math.round(item.preco * novaQtd * 100) / 100,
          };
        });
      }

      const novoItem = {
        id: produto.id,
        nome: produto.nome,
        preco: produto.preco,
        quantidade: qtdSelecionada,
        subtotal: Math.round(produto.preco * qtdSelecionada * 100) / 100,
      };

      return [...atual, novoItem];
    });

    setQuantidades((atual) => ({ ...atual, [produto.id]: 1 }));
  }

  function removerItem(id) {
    setPedido((atual) => atual.filter((item) => item.id !== id));
    setResumoVisivel(false);
  }

  function novoPedido() {
    setPedido([]);
    setResumoVisivel(false);
  }

  const totalGeral = pedido.reduce((soma, item) => soma + item.subtotal, 0);
  const totalUnidades = pedido.reduce((soma, item) => soma + item.quantidade, 0);

  return (
    <ScrollView
      style={styles.tela}
      contentContainerStyle={styles.container}
    >
      <Text style={styles.titulo}>Lanchonete Universitária</Text>

      <Text style={styles.secao}>Cardápio</Text>
      {CARDAPIO.map((produto) => (
        <View key={produto.id} style={styles.cardProduto}>
          <View style={styles.infoProduto}>
            <Text style={styles.nomeProduto}>{produto.nome}</Text>
            <Text style={styles.precoProduto}>
              {formatarMoeda(produto.preco)}
            </Text>
          </View>

          <View style={styles.controles}>
            <TouchableOpacity
              style={styles.botaoQtd}
              onPress={() => alterarQuantidade(produto.id, -1)}
            >
              <Text style={styles.textoQtd}>−</Text>
            </TouchableOpacity>

            <Text style={styles.valorQtd}>{quantidades[produto.id]}</Text>

            <TouchableOpacity
              style={styles.botaoQtd}
              onPress={() => alterarQuantidade(produto.id, 1)}
            >
              <Text style={styles.textoQtd}>+</Text>
            </TouchableOpacity>

            <TouchableOpacity
              style={styles.botaoAdicionar}
              onPress={() => adicionarItem(produto)}
            >
              <Text style={styles.textoBotao}>Adicionar</Text>
            </TouchableOpacity>
          </View>
        </View>
      ))}

      <Text style={styles.secao}>Itens do Pedido ({pedido.length})</Text>

      {pedido.length === 0 ? (
        <Text style={styles.vazio}>Nenhum item adicionado ao pedido.</Text>
      ) : (
        <>
          {pedido.map((item) => (
            <View key={item.id} style={styles.cardPedido}>
              <View style={styles.linhaTopo}>
                <Text style={styles.nomeItem}>
                  {item.quantidade}x {item.nome}
                </Text>
                <Text style={styles.subtotalItem}>
                  {formatarMoeda(item.subtotal)}
                </Text>
              </View>

              <View style={styles.linhaBase}>
                <Text style={styles.detalheItem}>
                  Unitário: {formatarMoeda(item.preco)}
                </Text>
                <TouchableOpacity onPress={() => removerItem(item.id)}>
                  <Text style={styles.textoRemover}>Remover</Text>
                </TouchableOpacity>
              </View>
            </View>
          ))}

          <View style={styles.barraTotal}>
            <Text style={styles.labelTotal}>Total parcial:</Text>
            <Text style={styles.valorTotal}>{formatarMoeda(totalGeral)}</Text>
          </View>

          <TouchableOpacity
            style={styles.botaoFinalizar}
            onPress={() => setResumoVisivel(true)}
          >
            <Text style={styles.textoBotao}>Finalizar pedido</Text>
          </TouchableOpacity>
        </>
      )}

      {resumoVisivel && pedido.length > 0 && (
        <View style={styles.cardResumo}>
          <Text style={styles.tituloResumo}>Resumo Final do Pedido</Text>

          {pedido.map((item) => (
            <View key={item.id} style={styles.linhaResumo}>
              <Text style={styles.textoResumo}>
                {item.quantidade}x {item.nome} ({formatarMoeda(item.preco)})
              </Text>
              <Text style={styles.textoResumo}>
                {formatarMoeda(item.subtotal)}
              </Text>
            </View>
          ))}

          <View style={styles.divisor} />

          <View style={styles.linhaResumo}>
            <Text style={styles.labelResumoFinal}>
              Total ({totalUnidades} {totalUnidades === 1 ? 'item' : 'itens'}):
            </Text>
            <Text style={styles.valorResumoFinal}>
              {formatarMoeda(totalGeral)}
            </Text>
          </View>

          <TouchableOpacity style={styles.botaoNovo} onPress={novoPedido}>
            <Text style={styles.textoNovo}>Novo pedido</Text>
          </TouchableOpacity>
        </View>
      )}
    </ScrollView>
  );
}

